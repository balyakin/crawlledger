route {
	@crawlledger_allow_googlebot {
		vars {crawlledger_crawler} "Googlebot"
	}
	handle @crawlledger_allow_googlebot {
		vars crawlledger_policy allow
	}

	@crawlledger_deny_wp_admin {
		method GET POST
		path_regexp crawlledger_deny_wp_admin_path "(?:^/wp-admin(?:/|$))"
	}
	handle @crawlledger_deny_wp_admin {
		respond "Forbidden" 403
	}

	handle {
		vars crawlledger_policy default
	}
}
