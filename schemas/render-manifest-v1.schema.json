{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crawlledger:schema:render-manifest:v1",
  "title": "CrawlLedger render manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool_version", "target", "tested_version", "analysis_id", "run_id", "policy_hash", "simulation_sha256", "workspace_manifest_sha256", "acknowledged_risks", "files", "nginx_zones", "instructions", "not_applied"],
  "properties": {
    "schema_version": {"const": 1},
    "tool_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "target": {"enum": ["nginx", "caddy"]},
    "tested_version": {"enum": ["nginx 1.30.4", "caddy 2.11.4"]},
    "analysis_id": {"type": "string", "pattern": "^an_[0-9a-f]{32}$"},
    "run_id": {"type": "string", "pattern": "^pr_[0-9a-f]{16}$"},
    "policy_hash": {"$ref": "#/$defs/sha256"},
    "simulation_sha256": {"$ref": "#/$defs/sha256"},
    "workspace_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "acknowledged_risks": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "files": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"$ref": "#/$defs/artifact"}},
    "nginx_zones": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/zone"}},
    "instructions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "not_applied": {"const": true}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "bytes", "sha256"],
      "properties": {
        "name": {"enum": ["crawlledger-http.conf", "crawlledger-server.conf", "Caddyfile.crawlledger"]},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "zone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "observed_states", "bytes_per_state", "headroom", "zone_mib", "warning"],
      "properties": {
        "profile": {"enum": ["gentle", "standard", "strict"]},
        "observed_states": {"type": "integer", "minimum": 0},
        "bytes_per_state": {"const": 256},
        "headroom": {"const": 2},
        "zone_mib": {"type": "integer", "minimum": 1, "maximum": 256},
        "warning": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    }
  }
}
