{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crawlledger:schema:policy:v1",
  "title": "CrawlLedger policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "description", "rules"],
  "properties": {
    "schema_version": {"const": 1},
    "name": {"$ref": "#/$defs/id"},
    "description": {"type": "string", "maxLength": 4096},
    "rules": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/rule"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "stringSet": {"type": "array", "maxItems": 50, "uniqueItems": true, "items": {"type": "string"}},
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "match", "action"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "match": {
          "type": "object",
          "additionalProperties": false,
          "required": ["crawler_names", "categories", "path_prefixes", "methods"],
          "properties": {
            "crawler_names": {"$ref": "#/$defs/stringSet"},
            "categories": {
              "type": "array",
              "maxItems": 50,
              "uniqueItems": true,
              "items": {"enum": ["claimed_ai_crawler", "claimed_search_crawler", "claimed_other_crawler"]}
            },
            "path_prefixes": {
              "type": "array",
              "maxItems": 50,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^/"}
            },
            "methods": {
              "type": "array",
              "maxItems": 50,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,15}$"}
            }
          }
        },
        "action": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "rate_profile", "cache_ttl_seconds"],
          "properties": {
            "kind": {"enum": ["allow", "deny", "rate_limit", "cache"]},
            "rate_profile": {"type": ["string", "null"], "enum": ["gentle", "standard", "strict", null]},
            "cache_ttl_seconds": {"type": ["integer", "null"], "minimum": 1, "maximum": 86400}
          }
        }
      }
    }
  }
}
